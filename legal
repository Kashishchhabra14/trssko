  <style>
    :root {
      --saffron: #D4621B; --cream: #FAF7F2; --ink: #1A1410; --ink-60: #6B5E54; --white: #FFFFFF; --border: #E8E0D8; --gold: #C9A84C;
      --ff-display: 'Cormorant Garamond', Georgia, serif; --ff-body: 'DM Sans', sans-serif; --ff-mono: 'DM Mono', monospace; --max-w: 1200px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--ff-body); background: var(--cream); color: var(--ink); line-height: 1.6; }
    a { text-decoration: none; color: inherit; }
    
    nav { position: sticky; top: 0; z-index: 100; background: rgba(250,247,242,0.92); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border); }
    .nav-inner { max-width: var(--max-w); margin: 0 auto; padding: 0 24px; height: 72px; display: flex; align-items: center; justify-content: space-between; }
    .nav-logo { font-family: var(--ff-display); font-size: 1.65rem; font-weight: 600; }
    .nav-logo span { color: var(--saffron); }
    .nav-links { display: flex; gap: 32px; list-style: none; }
    .nav-links a { font-size: 0.9rem; font-weight: 500; color: var(--ink-60); }
    .nav-links .active-page { color: var(--saffron); font-weight: 600; }

    section { padding: 80px 24px; }
    .section-inner { max-width: var(--max-w); margin: 0 auto; }
    .legal-hero { background: var(--ink); color: var(--white); padding: 80px 24px; text-align: center; }
    
    .table-container { background: var(--white); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-top: 40px; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem; }
    th { background: #EFECE6; color: var(--ink); font-weight: 600; padding: 16px 24px; border-bottom: 1px solid var(--border); }
    td { padding: 20px 24px; border-bottom: 1px solid var(--border); color: var(--ink-60); }
    tr:last-child td { border-bottom: none; }
    .code-string { font-family: var(--ff-mono); background: #FAF7F2; padding: 4px 8px; border-radius: 4px; color: var(--saffron); font-size: 0.85rem; font-weight: 500; }

    footer { background: var(--ink); color: rgba(255,255,255,0.55); padding: 60px 24px 32px; margin-top: 100px; }
  </style>
</head>
<body>

